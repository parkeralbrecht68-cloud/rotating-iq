---
/*
 * AFTERGLOW — single-file Astro app
 * Replace src/pages/index.astro with this entire file. No npm packages required.
 * Run your existing Astro project with: npm run dev
 *
 * WORKS IMMEDIATELY: editable drink log, U.S. standard-drink calculations,
 * personal caps, water log, optional BAC model, local profile, session history,
 * local group plans, native sharing, JSON export, and responsive navigation.
 * Data is stored in this browser, not in an account. Private browsing or clearing
 * site data can remove it. Nothing is publicly broadcast by this file.
 *
 * OPTIONAL LIVE BARS:
 * 1. Enable Maps JavaScript API and Places API (New) in Google Cloud with billing.
 * 2. Create a browser key restricted to your site's HTTP referrers and these APIs.
 * 3. Add PUBLIC_GOOGLE_MAPS_API_KEY=your_restricted_browser_key to .env; restart
 *    the dev server / rebuild the site. Never put a server secret in PUBLIC_*.
 * Search uses the new Place.searchByText API. Google can return a limited set,
 * not every bar in an area. Results and photo credits remain in memory only.
 * Without a key, clearly labeled illustrative venues and Google Maps links work.
 *
 * OPTIONAL SECURE ACCOUNTS + OWNER LISTINGS:
 * Run afterglow-supabase-setup.sql once, then add PUBLIC_SUPABASE_URL and
 * PUBLIC_SUPABASE_ANON_KEY to .env. The public key is safe for browser use only
 * because the supplied Row Level Security policies enforce owner permissions.
 * Never expose a service_role key. Without these values, every original local
 * Afterglow feature still works and the account screen explains what is missing.
 *
 * SOCIAL: plans and invitations work locally. Real user accounts, member search,
 * chat, live attendance, and location broadcasts require an authenticated backend
 * with access controls; this file does not simulate those services as live.
 *
 * HEALTH MODEL: ethanol g = mL * ABV/100 * 0.789; U.S. drinks = ethanol g / 14.
 * Optional adult Watson body-water model uses height, weight and age. It assumes
 * instant absorption and a fixed 0.015 g/dL/h elimination rate. Individual values
 * can be substantially outside its output. Two reference outputs are not a
 * confidence interval. Logged water, food, and a new session never erase BAC.
 * Sources / methodology are linked in the in-app guide. No driving clearance,
 * countdown to sobriety, or rewards for alcohol quantity are implemented.
 */
const placesKey = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY || "";
const supabaseUrl = (import.meta.env.PUBLIC_SUPABASE_URL || "").replace(/\/$/, "");
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || "";
const drinkPresets = [
  { id: "beer", name: "Beer", emoji: "🍺", oz: 12, abv: 5, color: "#e4ae66" },
  { id: "wine", name: "Wine", emoji: "🍷", oz: 5, abv: 12, color: "#c981a0" },
  { id: "cocktail", name: "Cocktail", emoji: "🍸", oz: 6, abv: 15, color: "#f7906b" },
  { id: "spirit", name: "Spirit", emoji: "🥃", oz: 1.5, abv: 40, color: "#c99d78" },
  { id: "seltzer", name: "Seltzer", emoji: "🫧", oz: 12, abv: 5, color: "#a3bcb9" },
  { id: "zero", name: "Zero proof", emoji: "🍋", oz: 8, abv: 0, color: "#c0c97b" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#191419" />
    <meta name="description" content="Afterglow: keep track of your drinks, discover your next spot, and make a thoughtful plan with your people." />
    <title>Afterglow — Your night, your pace.</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='18' fill='%23ff996e'/%3E%3Cpath d='M16 35a16 16 0 0 1 32 0M13 41h38M20 48h24M32 8v6M10 17l5 5M54 17l-5 5' stroke='%23271b25' stroke-width='4' fill='none' stroke-linecap='round'/%3E%3C/svg%3E" />
  </head>
  <body>
    <svg class="svg-library" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <defs>
        <symbol id="i-sun" viewBox="0 0 24 24"><path d="M5 14a7 7 0 0 1 14 0M3 17h18M6 21h12M12 1v3M3 5l2 2M21 5l-2 2" /></symbol>
        <symbol id="i-home" viewBox="0 0 24 24"><path d="m3 10 9-7 9 7v10H3Z M9 20v-7h6v7" /></symbol>
        <symbol id="i-pin" viewBox="0 0 24 24"><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z"/><circle cx="12" cy="10" r="2.5"/></symbol>
        <symbol id="i-users" viewBox="0 0 24 24"><circle cx="9" cy="7" r="3"/><path d="M3 21v-3a6 6 0 0 1 12 0v3M17 4a3 3 0 0 1 0 6M17 13a5 5 0 0 1 4 5v3"/></symbol>
        <symbol id="i-award" viewBox="0 0 24 24"><path d="M8 3h8v6a4 4 0 0 1-8 0ZM8 5H4v3a4 4 0 0 0 5 4M16 5h4v3a4 4 0 0 1-5 4M12 13v7M8 21h8"/></symbol>
        <symbol id="i-user" viewBox="0 0 24 24"><circle cx="12" cy="7" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></symbol>
        <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M4 12h15m-6-6 6 6-6 6"/></symbol>
        <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
        <symbol id="i-close" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"/></symbol>
        <symbol id="i-drop" viewBox="0 0 24 24"><path d="M12 2S5 10 5 15a7 7 0 0 0 14 0c0-5-7-13-7-13Z M9 16a3 3 0 0 0 3 3"/></symbol>
        <symbol id="i-glass" viewBox="0 0 24 24"><path d="m4 3 8 10 8-10ZM12 13v8M8 21h8M7 7h10"/></symbol>
        <symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 6v6l4 2"/></symbol>
        <symbol id="i-shield" viewBox="0 0 24 24"><path d="m12 2 8 4v6c0 5-8 10-8 10S4 17 4 12V6ZM8 12l3 3 5-6"/></symbol>
        <symbol id="i-spark" viewBox="0 0 24 24"><path d="m12 2 3 7 7 3-7 3-3 7-3-7-7-3 7-3Z"/></symbol>
        <symbol id="i-car" viewBox="0 0 24 24"><path d="m3 12 3-7h12l3 7v7H3ZM3 12h18M7 19v2M17 19v2M6 15h2M16 15h2"/></symbol>
        <symbol id="i-search" viewBox="0 0 24 24"><circle cx="10" cy="10" r="6.5"/><path d="m15 15 6 6"/></symbol>
        <symbol id="i-heart" viewBox="0 0 24 24"><path d="M20 5c-3-3-6-1-8 1-2-2-5-4-8-1-5 5 3 11 8 15 5-4 13-10 8-15Z"/></symbol>
        <symbol id="i-share" viewBox="0 0 24 24"><path d="M12 16V2m-5 5 5-5 5 5M5 12H3v9h18v-9h-2"/></symbol>
        <symbol id="i-edit" viewBox="0 0 24 24"><path d="m16 3 5 5L9 20l-6 1 1-6ZM13 6l5 5"/></symbol>
        <symbol id="i-info" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7v.1"/></symbol>
        <symbol id="i-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></symbol>
        <symbol id="i-trash" viewBox="0 0 24 24"><path d="M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7M14 10v7"/></symbol>
        <symbol id="i-lock" viewBox="0 0 24 24"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3"/></symbol>
