---
// ROTATE IQ · reviewed map snapshots and temporal ground-route planning.
// Replace src/pages/index.astro with this whole file. No additional packages.
// All geometry is approximate image tracing. The model is not live match telemetry.
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="theme-color" content="#0a1017" />
  <title>Rotate IQ · Terrain & timing</title>
  <style is:global>
    :root{color-scheme:dark;--bg:#0a1017;--panel:#101922;--raised:#16222d;--line:#293945;--text:#eef5f6;--muted:#a5b4bc;--green:#9de3bf;--amber:#ffd18a;--red:#ff989e;--blue:#8ccaff;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
    *{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text)}button,input,select{font:inherit;color:inherit}button,select,input[type=number]{border:1px solid var(--line);background:var(--raised);border-radius:8px}button,select{padding:9px 12px}button{cursor:pointer;transition:background .15s,border-color .15s}button:hover{background:#223442;border-color:#536876}button:disabled{opacity:.5;cursor:wait}button:focus-visible,select:focus-visible,input:focus-visible,summary:focus-visible,canvas:focus-visible{outline:2px solid var(--green);outline-offset:3px}button.active{border-color:var(--green);background:#243d35;color:#c8f8dc}button.primary{background:var(--green);border-color:var(--green);color:#102a22;font-weight:750}button.primary:hover{background:#bbf3d6}button.quiet{background:transparent}a{color:var(--green)}input[type=number]{width:100%;padding:10px 9px;min-width:0}input[type=range]{width:100%;accent-color:var(--green);cursor:pointer}input[type=checkbox]{accent-color:var(--green);width:15px;height:15px;margin:0}select{max-width:100%}small,.muted{color:var(--muted)}small{font-size:11px;line-height:1.5}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}[hidden]{display:none!important}
    header{height:74px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 26px;gap:16px}.brand{display:flex;align-items:center;gap:12px}.brand-icon{width:37px;height:37px;border:1px solid #81caaa;border-radius:11px;display:grid;place-items:center;color:var(--green);font-size:26px;line-height:1;transform:rotate(-12deg)}.wordmark{font-size:18px;letter-spacing:1.8px;font-weight:850}.wordmark span{color:var(--green)}.subtitle{font-size:10px;color:var(--muted);letter-spacing:1.5px;margin-top:3px}.header-actions{display:flex;gap:8px;align-items:center}.header-tag{font-size:11px;color:var(--muted);margin-right:10px}
    main{display:grid;grid-template-columns:minmax(0,1fr) 358px;gap:18px;max-width:1900px;margin:auto;padding:20px 24px 28px;align-items:start}.map-column{min-width:0;position:sticky;top:16px}.map-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:0 0 12px}.map-heading select{font-size:14px;font-weight:650;width:min(410px,70%)}.eyebrow{font-size:10px;letter-spacing:1.6px;text-transform:uppercase;color:var(--muted);font-weight:700}.chip{display:inline-flex;align-items:center;gap:6px;font-size:10px;padding:5px 8px;border:1px solid var(--line);border-radius:20px;white-space:nowrap;color:var(--muted)}.chip i{width:5px;height:5px;border-radius:50%;background:var(--green)}
    .map-shell{border:1px solid #344855;border-radius:14px;overflow:hidden;background:#0d2030;position:relative}.viewport{position:relative;height:min(72vh,840px);min-height:480px;overflow:hidden}.viewport canvas{display:block;width:100%;height:100%;touch-action:none;cursor:crosshair}.map-badges{position:absolute;top:15px;left:15px;display:flex;gap:7px;pointer-events:none;flex-wrap:wrap;right:58px}.map-badges span{background:#0a1525e8;padding:6px 9px;border:1px solid #426170;border-radius:6px;font-size:10px;color:#e0ecf1}.view-controls{position:absolute;top:14px;right:13px;display:grid;gap:5px}.view-controls button{width:34px;height:34px;padding:0;background:#0b1727ec;font-size:18px}.view-controls button:last-child{font-size:13px}.map-tools{position:absolute;bottom:16px;left:14px;display:flex;gap:5px;flex-wrap:wrap;right:14px;pointer-events:none}.map-tools button{pointer-events:auto;background:#0c1828f2;font-size:11px;padding:9px 10px;border-color:#486071}.map-tools button.active{background:#b5eccf;color:#102d22;border-color:#d3ffe6}.map-loading{position:absolute;inset:0;display:grid;place-items:center;background:#102033;z-index:2;font-size:14px}.map-loading span{max-width:300px;text-align:center;line-height:1.5}
    .playback{background:#111e29;padding:13px 17px 14px;border-top:1px solid #324959}.playback-top{display:flex;align-items:center;gap:9px}.playback-top button{padding:7px 10px;font-size:12px}.playback-top .time{font-variant-numeric:tabular-nums;font-size:14px;font-weight:750;min-width:98px}.playback-top select{padding:6px;font-size:11px;margin-left:auto}.phase{font-size:11px;color:var(--amber);margin-left:6px}.timeline{position:relative;margin-top:8px}.timeline input{display:block;margin:0}.timeline-labels{display:flex;justify-content:space-between;font-size:9px;letter-spacing:.5px;color:var(--muted);margin-top:5px}.timeline-tick{position:absolute;width:1px;height:6px;background:var(--amber);top:17px;pointer-events:none}.map-caption{display:flex;justify-content:space-between;gap:16px;margin-top:12px;font-size:11px;color:var(--muted);line-height:1.6}.map-caption p{margin:0;max-width:65ch}.map-caption a{white-space:nowrap}.layers{display:flex;gap:14px;flex-wrap:wrap;margin-top:14px;align-items:center;font-size:11px}.check{display:flex;align-items:center;gap:7px;cursor:pointer}.key{width:7px;height:7px;border-radius:50%;display:inline-block}.legend{display:flex;gap:16px;flex-wrap:wrap;font-size:10px;color:var(--muted);margin:12px 0 0}.legend span{display:flex;align-items:center;gap:6px}.key.you{background:var(--blue)}.key.traffic{border:1px solid var(--amber)}.key.seen{background:var(--red)}.key.path{background:var(--green);width:18px;height:3px;border-radius:2px}
    aside{display:flex;flex-direction:column;gap:12px}.panel{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:18px}.advice{border-color:#487462;background:linear-gradient(145deg,#162b26,#111e27 70%)}.advice-top{display:flex;justify-content:space-between;align-items:center;gap:8px}.advice h1{font-size:27px;letter-spacing:-.8px;line-height:1.13;margin:15px 0 9px}.advice p{font-size:12px;line-height:1.65;color:#c4d4d8;margin:0 0 15px}.advice .primary{width:100%;padding:12px 8px;font-size:13px}.metric-grid{display:grid;grid-template-columns:1fr 1fr;gap:0;margin:15px 0;border-top:1px solid #345247;border-bottom:1px solid #345247;padding:12px 0}.metric{padding:0 12px}.metric:first-child{padding-left:0;border-right:1px solid #345247}.metric strong{display:block;font-size:22px;font-variant-numeric:tabular-nums;letter-spacing:-.5px;margin-top:3px}.metric span{font-size:10px;color:var(--muted)}.advice-foot{display:flex;justify-content:space-between;font-size:10px;gap:8px;color:#bbd0c7;margin-bottom:14px}.warning{font-size:11px;line-height:1.5;color:var(--amber);background:#352b1a70;border:1px solid #715b374a;padding:10px;border-radius:7px;margin-top:12px}.warning button{font-size:10px;display:block;margin-top:7px;padding:5px 8px}.route-reasons{margin:12px 0 0;padding-left:17px;font-size:11px;color:#becdd3;line-height:1.65}.route-reasons li{margin:6px 0}.panel h2{font-size:12px;font-weight:750;letter-spacing:.2px;margin:0 0 13px}.row{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px}.field{font-size:11px;display:flex;flex-direction:column;gap:6px;min-width:0}.field span{color:#bdcbd1;line-height:1.4}.field small{font-size:10px}.panel .check{font-size:11px;line-height:1.45;margin-top:12px}.help{font-size:11px;color:var(--muted);line-height:1.6;margin:12px 0 0}.section-number{color:#79a18e;font-size:10px;margin-right:8px}.inline-heading{display:flex;align-items:center;justify-content:space-between;gap:10px}.inline-heading h2{margin:0}.inline-heading output{font-size:12px;font-variant-numeric:tabular-nums;color:var(--green)}details.panel{padding:0}details.panel>summary{padding:16px 18px;cursor:pointer;font-size:12px;font-weight:650}details .details-body{padding:0 18px 18px}details p{font-size:11px;line-height:1.6;color:var(--muted);margin:0 0 12px}.editor-actions{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px}.editor-actions button{font-size:10px;padding:7px 9px}.status{font-size:11px;min-height:18px;line-height:1.5;color:var(--amber);padding:0 3px}.edit-list{max-height:130px;overflow:auto;margin-top:10px}.edit-list button{font-size:10px;display:block;width:100%;text-align:left;margin-top:4px;padding:6px 8px}.source-note{font-size:10px;line-height:1.65;color:#98a8b2;padding:0 3px}.source-note p{margin:0 0 7px}.coordinate-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.file-button{display:block;margin:10px 0;font-size:11px}.file-button input{display:block;width:100%;font-size:10px;margin-top:8px}.map-notice{position:absolute;bottom:67px;left:14px;right:14px;font-size:11px;color:#fff1c3;background:#142332ec;border:1px solid #60727c;padding:8px 11px;border-radius:6px;pointer-events:none;line-height:1.4}
    @media(min-width:1600px){main{grid-template-columns:minmax(0,1fr) 390px}.viewport{height:min(79vh,1000px)}}
    @media(max-width:1100px){main{padding:14px;gap:12px;grid-template-columns:minmax(0,1fr) 320px}.panel{padding:15px}.viewport{min-height:420px}.map-tools button{padding:8px;font-size:10px}.map-heading select{font-size:12px}.chip{font-size:9px}.header-tag{display:none}.phase{display:none}}
    @media(max-width:820px){header{height:65px;padding:0 15px}.wordmark{font-size:15px}.subtitle{font-size:8px}.header-actions button{padding:7px 8px;font-size:10px}main{display:block;padding:12px}.map-column{position:static}.map-heading{gap:5px}.map-heading select{width:75%;font-size:12px}.map-heading .chip{font-size:8px}.viewport{height:63svh;min-height:370px;max-height:650px}.map-caption{font-size:10px}.map-caption a{white-space:normal}aside{margin-top:16px;display:grid;grid-template-columns:1fr 1fr;align-items:start;gap:12px}.advice{grid-row:span 2}.source-note,.status{grid-column:1/-1}.map-tools{bottom:11px;left:10px}.map-notice{bottom:62px;left:10px}.layers{gap:12px}.playback{padding:12px}.playback-top .time{min-width:85px;font-size:12px}.playback-top{gap:6px}}
    @media(max-width:540px){aside{display:flex}.header-actions{gap:5px}.brand-icon{display:none}.map-caption{display:block}.map-caption a{display:inline-block;margin-top:5px}.map-heading .chip{display:none}.map-heading select{width:100%}.viewport{height:58svh;min-height:350px}.map-tools button{font-size:9px;padding:8px}.map-badges{top:11px;left:11px}.map-badges span{font-size:9px}.legend{gap:10px}.timeline-labels{font-size:8px}}
    @media(prefers-reduced-motion:reduce){button{transition:none}}
  </style>
</head>
<body>
<header>
  <div class="brand"><div class="brand-icon" aria-hidden="true">↗</div><div><div class="wordmark">ROTATE <span>IQ</span></div><div class="subtitle">TERRAIN. TIMING. POSITION.</div></div></div>
  <div class="header-actions"><span class="header-tag">Tournament preparation</span><button id="save" type="button">Save setup</button><button id="restore" type="button" class="quiet">Restore</button></div>
</header><div id="actionStatus" role="status" aria-live="polite" style="padding:8px 24px;font-size:12px;color:var(--amber);min-height:30px"></div>
<main>
  <section class="map-column" aria-label="Interactive rotation map">
    <div class="map-heading"><label for="mapSelect" class="sr-only">Map</label><select id="mapSelect"><option value="venture">Reload · Venture / Tilted Towers</option><option value="br">Battle Royale · reviewed snapshot</option></select><span class="chip"><i></i> GROUND ROTATION</span></div>
    <div class="map-shell">
      <div id="viewport" class="viewport">
        <canvas id="mapCanvas" tabindex="0" aria-label="Rotation map. Choose a tool and click to place your position, safe circle, a destination inside the circle, or an observed enemy. Use the coordinate controls below for keyboard placement."></canvas>
        <div class="map-badges"><span id="mapBadge">VENTURE · TILTED TOWERS</span><span id="playerCountBadge">40 / 40 PLAYERS</span><span id="detailBadge">Loading original imagery…</span></div>
        <div class="view-controls"><button id="zoomIn" aria-label="Zoom in">+</button><button id="zoomOut" aria-label="Zoom out">−</button><button id="fit" aria-label="Fit map">↗</button><button id="native" aria-label="View at native image resolution">1:1</button></div>
        <div id="mapNotice" class="map-notice">Example setup. Place your position and the revealed safe circle.</div>
        <div id="mapTools" class="map-tools" role="group" aria-label="Map placement tools"><button data-tool="player" class="active" aria-pressed="true">● Your position</button><button data-tool="zone" aria-pressed="false">◯ Safe circle</button><button data-tool="destination" aria-pressed="false">⚑ Destination</button><button data-tool="enemy" aria-pressed="false">＋ Seen enemy</button><button data-tool="pan" aria-pressed="false">✥ Pan</button><button id="terrainTool">Edit terrain</button></div>
        <div id="loading" class="map-loading"><span>Loading the reviewed map…</span></div>
      </div>
      <div class="playback" aria-label="Storm and route playback">
        <div class="playback-top"><button id="play" aria-label="Play simulation">▶ Play</button><button id="back" aria-label="Back 10 seconds">−10</button><button id="forward" aria-label="Forward 10 seconds">+10</button><div class="time"><output id="elapsedText">0:00</output><span class="muted"> / </span><span id="totalText">4:00</span></div><span class="phase" id="phaseText">Circle revealed</span><label for="playSpeed" class="sr-only">Playback speed</label><select id="playSpeed"><option value="1">1×</option><option value="4" selected>4×</option><option value="8">8×</option></select></div>
        <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;margin-top:9px;font-size:11px"><span id="movementText">Waiting for simulation</span><button id="nextMovement" style="font-size:10px;padding:5px 8px">Next movement</button></div><div class="timeline"><label for="scrub" class="sr-only">Seconds since circle reveal</label><input id="scrub" type="range" min="0" max="240" step="1" value="0" /><i id="moveTick" class="timeline-tick"></i><div class="timeline-labels"><span>REVEAL</span><span id="movingLabel">STORM MOVES 1:30</span><span id="closedLabel">CLOSED 4:00</span></div></div>
      </div>
    </div>
    <div class="layers"><label class="check"><input id="showTraffic" type="checkbox" checked /> Estimated players</label><label class="check"><input id="showHeat" type="checkbox" /> Exposure overlay</label><label class="check"><input id="showTerrain" type="checkbox" /> Terrain outlines</label><label class="check"><input id="smooth" type="checkbox" /> Smooth imagery</label></div>
    <div class="legend"><span><i class="key you"></i>Your position</span><span><i class="key path"></i>Planned route</span><span><i class="key traffic"></i>Estimated player</span><span><i class="key seen"></i>Observed enemy</span></div>
    <div class="map-caption"><p id="mapHelp">Scroll to zoom. Drag to pan. In safe-circle mode, drag its edge to resize. All terrain outlines are approximate and editable.</p><a id="sourceLink" href="https://fortnite-api.com/images/map_en.png" target="_blank" rel="noreferrer">View source image ↗</a></div>
  </section>
  <aside aria-label="Route advice and match settings">
    <section class="panel advice" aria-labelledby="adviceTitle">
      <div class="advice-top"><span class="eyebrow">WHEN TO ROTATE</span><span class="chip" id="planBadge">SET YOUR POSITION</span></div>
      <h1 id="adviceTitle">Use cover.<br />Move with time.</h1>
      <p id="adviceText">Place yourself and the current safe circle. Compare ground routes through the mapped terrain and estimated traffic.</p>
      <div class="metric-grid"><div class="metric"><span>TRAVEL TIME</span><strong id="travelMetric">—</strong></div><div class="metric"><span id="leaveMetricLabel">LEAVE IN</span><strong id="leaveMetric">—</strong></div></div>
      <div class="advice-foot"><span id="arrivalText">Arrival —</span><span id="distanceText">Distance —</span></div>
      <p id="destinationInfo" class="help">Destination: automatically choose a spot inside the circle.</p><div class="editor-actions" style="margin-bottom:10px"><button id="pickDestination">Pick destination</button><button id="clearDestination" hidden>Use automatic destination</button></div>
      <button id="generate" class="primary">Find safer rotation ↗</button>
      <button id="replan" class="quiet" hidden style="width:100%;font-size:11px;margin-top:8px">Replan from the playback position</button>
      <div id="calibrationWarning" class="warning">Timing uses an assumed map scale and average movement speed. Calibrate a known in-game distance before relying on the countdown.<button id="openCalibration">Calibrate distance</button></div>
      <ol id="routeReasons" class="route-reasons"></ol>
    </section>
    <section class="panel">
      <h2><span class="section-number">01</span> Storm timing</h2>
      <div class="row"><label class="field"><span>Current zone</span><select id="stage"><option value="1">Zone 1</option><option value="2">Zone 2</option><option value="3">Zone 3</option><option value="4" selected>Zone 4</option><option value="5">Zone 5</option><option value="6">Zone 6</option><option value="7">Zone 7</option><option value="8">Zone 8</option><option value="9">Zone 9</option></select></label><label class="field"><span>Safe radius · % of width</span><input id="radius" type="number" min="0.05" max="48" step="0.05" value="16.4" /></label></div>
      <div class="row"><label class="field"><span>Circle diameter (meters)</span><input id="zoneDiameter" type="number" min="1" max="40000" step="1" /></label><div class="field"><span>Current map + zone</span><button id="saveZoneSize">Record zone size</button></div></div><p id="zoneSizeNote" class="help">Actual zone size is not recorded.</p><p class="help">Recorded sizes are specific to this map and zone number. Meter values depend on map calibration. Current competitive size tables are not verified.</p>
      <div class="row"><label class="field"><span>Storm starts moving (s)</span><input id="moveAt" type="number" min="0" max="1199" step="5" value="90" /></label><label class="field"><span>Zone fully closes (s)</span><input id="closeAt" type="number" min="10" max="1200" step="5" value="240" /></label></div>
      <div class="row"><label class="field"><span>Safety buffer (s)</span><input id="buffer" type="number" min="0" max="180" step="5" value="15" /></label><label class="field"><span>Average speed (m/s)</span><input id="speed" type="number" min="0.5" max="25" step="0.1" value="4.5" /></label></div>
      <p class="help">Both times count from circle reveal. Set them from your match. The buffer covers delays, healing, and unexpected contact; speed should include your stops and terrain.</p>
    </section>
    <section class="panel">
      <h2><span class="section-number">02</span> Estimated player movement</h2>
      <div class="row"><label class="field"><span>Players remaining · includes your team</span><input id="players" type="number" min="1" max="100" value="40" /></label><label class="field"><span>Team size</span><select id="team"><option value="1">Solo</option><option value="2" selected>Duo</option><option value="3">Trio</option><option value="4">Squad</option></select></label></div>
      <label class="field" style="margin-top:14px"><span class="inline-heading"><span>Already inside at reveal</span><output id="insideText">35%</output></span><input id="inside" type="range" min="0" max="100" step="5" value="35" /></label>
      <p id="playerCountText" class="help">40 / 40 modeled players</p><p class="help">Each dot represents one player; blue dots are your team. This is a simulated count, not live match telemetry.  Other players begin outside the circle and travel toward it at different times along mapped ground routes. Observed enemies are added at the selected playback time.</p>
      <div class="editor-actions"><button id="clearEnemies">Clear observed enemies</button></div>
    </section>
    <details class="panel" id="terrainEditor"><summary>Review & edit terrain <span id="featureCount" class="muted"></span></summary><div class="details-body">
      <p>Trace visible obstacles and cover. Mountains and structures reduce estimated sight exposure only when they shield the route from an enemy. Heights, windows, destructibility, and player builds are not known.</p>
      <label class="field"><span>Outline type</span><select id="featureType"><option value="ridge">Ridge / cliff · avoid crossing</option><option value="building">Structure · avoid crossing</option><option value="water">Water · avoid or slow crossing</option><option value="cover">Trees / vegetation · soft concealment</option><option value="crossing">Verified bridge / crossing</option><option value="block">Other blocked ground</option></select></label>
      <div class="editor-actions"><button id="drawFeature">Draw outline</button><button id="finishFeature">Finish outline</button><button id="undoVertex">Undo point</button><button id="cancelFeature">Cancel</button></div>
      <p class="help">Click at least three corners, then Finish or Enter. A crossing overrides mapped water only. It cannot cut through a structure or ridge.</p>
      <label class="check"><input id="avoidWater" type="checkbox" checked /> Avoid swimming</label>
      <label class="check"><input id="reviewed" type="checkbox" /> I checked these outlines against this map in game</label>
      <div class="edit-list" id="featureList" aria-label="Terrain features; click to remove an outline"></div>
      <div class="editor-actions"><button id="undoFeature">Undo terrain edit</button><button id="resetTerrain">Restore snapshot outlines</button></div>
    </div></details>
    <details class="panel" id="calibration"><summary>Map scale & sharper imagery</summary><div class="details-body">
      <p id="imageQuality">The original map is embedded in this file. Its detail is limited to the source resolution.</p>
      <label class="field"><span>Map width in meters</span><input id="meters" type="number" min="200" max="20000" step="10" value="2000" /></label>
      <div class="editor-actions"><button id="measure">Measure two map points</button></div>
      <p id="measureHelp" class="help">Use the distance between two in-game waypoint locations.</p>
      <div class="row"><label class="field"><span>Measured distance (m)</span><input id="knownDistance" type="number" min="1" max="20000" value="250" /></label><div class="field"><span>&nbsp;</span><button id="applyScale">Apply scale</button></div></div>
      <label class="check"><input id="calibrated" type="checkbox" /> Scale and effective speed verified in game</label>
      <label class="file-button">Upload an original map image<input id="uploadMap" type="file" accept="image/png,image/jpeg,image/webp" /></label>
      <label class="check"><input id="sameFraming" type="checkbox" /> This image has exactly the same framing as the displayed map</label>
      <p class="help">Use a clean high-resolution minimap. A different crop or map resets the terrain outlines and calibration so old obstacles do not appear in the wrong place.</p>
    </div></details>
    <details class="panel"><summary>Precise placement & setup</summary><div class="details-body">
      <p>Coordinates are percentages from the left and top edges of the map.</p><div class="coordinate-grid"><label class="field"><span>Your X (%)</span><input id="playerX" type="number" min="0" max="100" step="0.1" /></label><label class="field"><span>Your Y (%)</span><input id="playerY" type="number" min="0" max="100" step="0.1" /></label><label class="field"><span>Circle X (%)</span><input id="zoneX" type="number" min="0" max="100" step="0.1" /></label><label class="field"><span>Circle Y (%)</span><input id="zoneY" type="number" min="0" max="100" step="0.1" /></label></div>
