    if(gesture.pinch)return;if(IQ.dist(p,gesture.start)>4)gesture.moved=true;if(!gesture.moved)return;
    if(gesture.kind==='pan'){camera.x=gesture.camera.x+p.x-gesture.start.x;camera.y=gesture.camera.y+p.y-gesture.start.y;}
    else {if(!gesture.changed){invalidate('',-1);gesture.changed=true;}state.example=false;const w=bounded(world(p));if(gesture.kind==='player')state.player=w;else if(gesture.kind==='destination'){if(IQ.dist(w,state.zone)<=state.zone.r)state.destination=w;}else if(gesture.kind==='zone'){state.zone.x=w.x;state.zone.y=w.y;}else state.zone.r=IQ.clamp(IQ.dist(w,state.zone),.5,480);syncCoordinates();note();}
    dirty=true;
  });
  function pointerEnd(e,cancelled=false){
    const g=gesture,p=local(e);pointers.delete(e.pointerId);if(!pointers.size)gesture=null;else if(g?.pinch)gesture={...g,pinch:true};
    if(!g||g.pinch)return;if(g.changed){refreshRoute();return;}if(cancelled||g.moved)return;
    const w=world(p);if(w.x<0||w.x>=1000||w.y<0||w.y>=map.h)return;
    state.example=false;
    if(tool==='polygon'){if(draft.length<1500)draft.push([w.x,w.y]);note();dirty=true;return;}
    if(tool==='measure'){if(measurePoints.length===2)measurePoints=[];measurePoints.push(w);if(measurePoints.length===2){$('measureHelp').textContent='Two waypoints selected. Enter their in-game distance, then apply scale.';setTool('player');}else note();dirty=true;return;}
    if(tool==='destination'){chooseDestination(w);return;}
    if(tool==='player')state.player=w;else if(tool==='zone'){state.zone.x=w.x;state.zone.y=w.y;}else if(tool==='enemy'){if(state.enemies.length>=100){status('Maximum 100 observed markers. Clear old observations first.');return;}state.enemies.push({...w,seenAt:elapsed});}else return;
    syncCoordinates();note();refreshRoute();
  }
  canvas.addEventListener('pointerup',e=>pointerEnd(e));canvas.addEventListener('pointercancel',e=>pointerEnd(e,true));
  canvas.addEventListener('wheel',e=>{e.preventDefault();const p=local(e);zoom(Math.exp(-e.deltaY*.001),p.x,p.y);},{passive:false});
  canvas.addEventListener('keydown',e=>{
    if(e.key==='Enter'&&tool==='polygon'){e.preventDefault();finishFeature();}if(e.key==='Escape'){draft=[];setTool('player');}
    if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight'].includes(e.key)){e.preventDefault();const p=tool==='destination'?{...(state.destination||state.zone)}:tool==='zone'?state.zone:state.player,step=e.shiftKey?10:2;p.x=IQ.clamp(p.x+(e.key==='ArrowRight'?step:e.key==='ArrowLeft'?-step:0),.01,999.99);p.y=IQ.clamp(p.y+(e.key==='ArrowDown'?step:e.key==='ArrowUp'?-step:0),.01,map.h-.01);if(tool==='destination'){chooseDestination({x:p.x,y:p.y});return;}state.example=false;syncCoordinates();refreshRoute();}
    if(e.key==='+'||e.key==='=')zoom(1.2);if(e.key==='-')zoom(1/1.2);if(e.key==='0')fit();
  });
  let last=0,lastUI=0;
  function frame(ms){const dt=last?Math.min(.1,(ms-last)/1000):0;last=ms;if(playing&&state){elapsed=Math.min(state.closeAt,elapsed+dt*Number($('playSpeed').value));dirty=true;if(elapsed>=state.closeAt)pause();if(ms-lastUI>180){syncClock();advice();lastUI=ms;}}if(dirty)draw();requestAnimationFrame(frame);}
  document.addEventListener('visibilitychange',()=>{if(document.hidden)pause();});
  if(typeof ResizeObserver!=='undefined')new ResizeObserver(resize).observe($('viewport'));else window.addEventListener('resize',resize);
  loadMap('venture');requestAnimationFrame(frame);
})();

</script>
</body>
</html>
